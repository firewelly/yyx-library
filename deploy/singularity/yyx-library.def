Bootstrap: docker
From: python:3.11-slim

# YYX书库 · Apptainer/Singularity 版（服务端查询架构）
#
# 构建（仓库根目录，先运行 deploy/docker/build.sh 生成 rootfs）：
#   deploy/docker/build.sh                    # 生成 deploy/docker/rootfs/{ui,bin,demo}
#   sudo apptainer build yyx-library.sif deploy/singularity/yyx-library.def
#
# 运行（书库/状态库放在宿主目录，通过 bind 挂载进容器）：
#   mkdir -p ~/yyx-data && cp novelmgt.db ~/yyx-data/   # 可选，缺省用内置示例库兜底
#   apptainer run --bind ~/yyx-data:/data yyx-library.sif
#   浏览器打开 http://<host>:12702/
#
# 离线环境（docker hub 受限时）：先在可联网机器 docker save 基础镜像与成品，
# 或直接从本地 docker 镜像转换：
#   apptainer build yyx-library.sif docker-daemon://yyx-library:10.0.3

%files
    deploy/docker/rootfs/ui /app/ui
    deploy/docker/rootfs/bin /app/bin
    deploy/docker/rootfs/demo /app/demo

%post
    mkdir -p /data

%environment
    export PORT=12702
    export DB=/data/novelmgt.db
    export STATE_DB=/data/novelmgt_state.db

%runscript
    mkdir -p /data
    exec python3 /app/bin/novel_server.py \
        --web-dir=/app/ui \
        --db="${DB:-/data/novelmgt.db}" \
        --state-db="${STATE_DB:-/data/novelmgt_state.db}" \
        --demo-db=/app/demo/novelmgt-demo.db \
        --port="${PORT:-12702}"

%labels
    Author firewelly
    Version 10.0.3
    Description YYX Library - personal novel library manager & reader (server-side architecture)
